FLASK_ENV=production
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
# En production Render, utilisez une vraie base PostgreSQL externe ou Render.
# Ne pas utiliser SQLite en production si vous voulez conserver les comptes et les données après redémarrage/redéploiement.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/ecbu_liaison_pro_v2
REDIS_URL=redis://localhost:6379/0
ADMIN_EMAIL=admin@hopital.cd
ADMIN_PASSWORD=ChangeMeStrongPassword123!
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=no-reply@hopital.cd
MAIL_PASSWORD=CHANGE_ME
MAIL_DEFAULT_SENDER=no-reply@hopital.cd
APP_BASE_URL=http://127.0.0.1:5000
SECURE_COOKIES=true
